# --- API (apps/api) ---
DATABASE_URL=postgresql://fm:fm@localhost:5432/freelance_marketplace
# At least 32 random characters, e.g. `openssl rand -hex 32`. The API refuses to start otherwise.
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=4000
# Comma-separated origins allowed to make state-changing requests (CSRF check)
WEB_ORIGIN=http://localhost:3000
# true only when the API sits behind a proxy that overwrites X-Forwarded-For (nginx)
TRUST_PROXY=false
# true in production (HTTPS)
COOKIE_SECURE=false

# --- Web (apps/web) ---
API_URL=http://localhost:4000
